# Copy to env.docker and set your API key, then:
#   docker compose --env-file env.docker up --build -d

# LLM Provider (openai | gemini | custom)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# For Gemini:
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-3.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional frontend port (default: 3010)
# FRONTEND_PORT=3010
